{
  "name": "@vishnucreator/desktop",
  "version": "1.0.0-khmer",
  "private": true,
  "description": "Vishnu Creator Local Codex Dashboard",
  "author": "Vishnu",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node ../../scripts/build-vishnuai.mjs && pnpm --filter @vishnucreator/protocol build && pnpm --filter @vishnucreator/config build",
    "pretypecheck": "pnpm --filter @vishnucreator/protocol build && pnpm --filter @vishnucreator/config build",
    "pretest": "pnpm --filter @vishnucreator/protocol build && pnpm --filter @vishnucreator/config build",
    "build:main": "node -e \"const fs=require('node:fs'); for (const path of ['dist/main','dist/shared']) fs.rmSync(path,{recursive:true,force:true})\" && tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload/index.cjs",
    "build:bootstrap": "vite build --config vite.bootstrap.config.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:bootstrap",
    "prepare:daemon": "node scripts/prepare-daemon.mjs",
    "prepare:codex-runtime": "node scripts/prepare-codex-runtime.mjs",
    "install:creator-runtime-dependencies": "node scripts/install-creator-runtime-dependencies.mjs",
    "prepare:creator-runtime": "node scripts/prepare-creator-runtime.mjs",
    "prepare:dub-engine-runtime": "node scripts/prepare-dub-engine-runtime.mjs",
    "prepare:stickman-runtime": "node scripts/prepare-stickman-runtime.mjs",
    "package": "node scripts/package-release.mjs --dir",
    "package:signed": "node scripts/package-release.mjs --dir --signed",
    "dist": "node scripts/package-release.mjs --dist",
    "release": "node scripts/package-release.mjs --release",
    "verify:release-tag": "node scripts/verify-desktop-release-tag.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:package": "playwright test --config playwright.config.ts",
    "e2e:package:smoke": "playwright test --config playwright.config.ts --grep @package-smoke",
    "e2e:real-codex": "playwright test --config playwright.real.config.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vishnucreator/config": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "1.8.0",
    "@iarna/toml": "2.2.5",
    "@types/node": "^22.10.7",
    "electron": "43.8.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "fontkit": "2.0.4",
    "node-gyp": "13.0.2",
    "sharp": "0.35.5",
    "typescript": "^5.7.3",
    "vite": "6.4.4",
    "vitest": "^3.2.7"
  }
}
