{
  "name": "vishnucreator-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prebuild": "pnpm vishnuai:build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "perf:measure": "playwright test apps/web/e2e/scheduled-task-performance.spec.ts",
    "typecheck": "pnpm -r typecheck",
    "smoke:ci": "pnpm --filter @vishnucreator/daemon test -- test/unit/codex-smoke.test.ts",
    "perf:check": "node scripts/check-performance-baseline.mjs",
    "release:verify-scheduled-task-upgrade": "pnpm --filter @vishnucreator/daemon verify:schedule-upgrade",
    "daemon:dev": "pnpm --filter @vishnucreator/daemon dev",
    "web:dev": "pnpm --filter @vishnucreator/web dev",
    "dub:engine": "node scripts/dub-engine.mjs",
    "harness": "pnpm --filter @vishnucreator/harness start",
    "desktop:dev": "pnpm --filter @vishnucreator/desktop dev",
    "desktop:build": "pnpm --filter @vishnucreator/desktop build",
    "desktop:package": "pnpm --filter @vishnucreator/desktop package",
    "desktop:dist": "pnpm --filter @vishnucreator/desktop dist",
    "desktop:release": "pnpm --filter @vishnucreator/desktop release",
    "desktop:test": "pnpm --filter @vishnucreator/desktop test",
    "templates:validate": "pnpm --filter @vishnucreator/daemon templates:validate",
    "templates:compile": "pnpm --filter @vishnucreator/daemon templates:compile",
    "templates:ci": "pnpm templates:validate && pnpm templates:compile",
    "templates:preview-videos": "node scripts/optimize-creator-preview-videos.mjs",
    "vishnuai:build": "node scripts/build-vishnuai.mjs",
    "vishnuai:package": "node scripts/package-vishnuai-release.mjs",
    "vishnuai:test": "node scripts/build-vishnuai.mjs --test-only",
    "languages:generate": "node scripts/generate-creator-languages.mjs",
    "languages:check": "node scripts/generate-creator-languages.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.7": "3.1.7",
      "http-cache-semantics@<=4.2.0": "4.3.0",
      "ip-address@<=10.3.0": "10.7.0",
      "find-my-way@<=9.6.0": "9.7.0",
      "postcss@<=8.5.17": "8.5.18",
      "proxy-addr@<2.0.8": "2.0.8",
      "source-map-js@<1.2.2": "1.2.2",
      "tinypool@<2.1.2": "2.1.2",
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
      "browserslist@<=4.28.6": "4.28.7",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": "0.8.15",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "tar@>=7.0.0 <=7.5.20": "7.5.21",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "vite@>=6.0.0 <6.4.4": "6.4.4",
      "zod@<4.6.6": "4.6.6",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0"
    }
  }
}
